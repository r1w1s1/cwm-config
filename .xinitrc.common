#!/bin/sh
# ~/.xinitrc.common

# Optional screen saver and display power management.
# xscreensaver -no-splash &
# xset +dpms
# xset dpms 600 1200 1800

# Apply the keyboard layout.
setxkbmap br thinkpad

# Hide the mouse cursor when it is inactive.
xhidecursor &

# Set the wallpaper.
hsetroot -fill /home/r1w1s1/wallpaper.png
