# Appearance, adapted from the dwm config.
fontname "Ttyp0 OTB:size=14"

borderwidth 1
snapdist 32

color activeborder "#cccccc"
color inactiveborder "#3a3a3a"
color menubg "#1c1c1c"
color menufg "#cccccc"
color font "#cccccc"
color selfont "#1c1c1c"

# Applications.
command termtab "tabbed -c -n termtab -r 2 st -w '' -e tmux"
command firefox "firefox"

# Keep system-wide shortcuts in cwm so they share one keyboard grab.
# This avoids handing global keys to a second daemon and keeps media,
# launcher, screenshot, lock, and menu actions consistent after windows close.
bind-key XF86AudioRaiseVolume "pactl set-sink-volume @DEFAULT_SINK@ +5%"
bind-key XF86AudioLowerVolume "pactl set-sink-volume @DEFAULT_SINK@ -5%"
bind-key XF86AudioMute "pactl set-sink-mute @DEFAULT_SINK@ toggle"
bind-key XF86AudioMicMute "/home/r1w1s1/.bin/toggle-call-audio.sh"
bind-key XF86MonBrightnessDown "brightnessctl set 10%-"
bind-key XF86MonBrightnessUp "brightnessctl set +10%"

bind-key 4-l "xscreensaver-command -lock"
bind-key 4S-l "xscreensaver-command -lock"
bind-key F12 "xscreensaver-command -lock"
bind-key 4-p "/home/r1w1s1/.bin/dmenu_run.sh"
bind-key Print "/home/r1w1s1/.bin/screenshot-full.sh"
bind-key 4-Print "/home/r1w1s1/.bin/screenshot-area.sh"
bind-key 4-space "/home/r1w1s1/.bin/menu"

# Use cwm groups like dwm tags/workspaces.
sticky yes
autogroup 1 firefox

# Main bindings, using Super/Mod4 like the dwm config.
bind-key 4S-Return /home/r1w1s1/.bin/cwm-terminal
bind-key 4-j window-cycle
bind-key 4-k window-rcycle
bind-key 4-c window-close
bind-key 4S-q quit
bind-key 4-r restart

# cwm equivalents for maximize, fullscreen, and minimize/hide.
bind-key 4-m window-maximize
bind-key 4-f window-fullscreen
bind-key 4-h window-hide
bind-key 4S-space window-freeze
bind-key 4-v window-vtile
bind-key 4S-v window-htile

# Groups: Super+number switches, Super+Shift+number moves window.
bind-key 4-1 group-only-1
bind-key 4-2 group-only-2
bind-key 4-3 group-only-3
bind-key 4-4 group-only-4
bind-key 4-5 group-only-5
bind-key 4-6 group-only-6
bind-key 4-7 group-only-7
bind-key 4-8 group-only-8
bind-key 4-9 group-only-9

bind-key 4S-1 window-movetogroup-1
bind-key 4S-2 window-movetogroup-2
bind-key 4S-3 window-movetogroup-3
bind-key 4S-4 window-movetogroup-4
bind-key 4S-5 window-movetogroup-5
bind-key 4S-6 window-movetogroup-6
bind-key 4S-7 window-movetogroup-7
bind-key 4S-8 window-movetogroup-8
bind-key 4S-9 window-movetogroup-9

# Mouse behavior like dwm: Super+left moves, Super+right resizes.
bind-mouse 4-1 window-move
bind-mouse 4-3 window-resize
